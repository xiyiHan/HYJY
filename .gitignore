# ============================================================
# 会议纪要工具 .gitignore
# ============================================================
# 【安全底线】
# 下面「禁止入库」部分涉及的目录里存放着真实会议录音、转写文字稿与
# 会议纪要，含单位名称、项目名称、人员姓名等业务信息，部分内容可能
# 涉及项目保密要求。任何时候都不得提交到版本库。
#
# 首次提交前务必执行 git status 逐项核对，确认这些目录没有出现在
# 待提交列表中。后续每次提交前也应确认一次。
# ============================================================

# ---------- 禁止入库：密钥 ----------
# 含 API Key 的文件路径；密钥本体在项目外的独立目录中管理
config.local.yaml
config.local.*.yaml
!config.local.yaml.example
*.key
*.pem

# ---------- 禁止入库：业务数据（涉密风险）----------
# 录音 WAV、转写文字稿、生成的纪要全部在此目录下
workspace/
*.m4a
*.mp3
*.wav
~$*.docx

# ---------- 禁止入库：体积与可重建物 ----------
models/
.cache/
.venv/
venv/
env/

# ---------- 禁止入库：构建产物 ----------
# 方案文档的 Word 版由 Markdown 生成，请勿提交，改 md 后重新导出
docs/*.docx
dist/
build/
*.spec

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- 编辑器与 IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---------- 日志与临时文件 ----------
*.log
*.tmp
*.bak
*.orig
*.rej
_sysinfo.py
_probe.*
